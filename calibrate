#!/usr/bin/env ruby

require 'csv'
require 'io/console'
require 'optparse'
require 'time'
require_relative 'lib/fc_software_interface'
require_relative 'lib/current_calibrator'
require_relative 'lib/voltage_calibrator'
require_relative 'lib/libutil/lib/term'

class XOptionParser < OptionParser

    def initialize
        super
        self.banner = "Usage: #$0 [options] serial_device"
        on('-t value', '--acquisition-time=value', 'set sampling time in seconds') { |value| @acquisition_time = value }
        on('-v', '--voltage', 'calibrate only voltage') { @calibration_targets << :voltage }
        on('-c', '--current', 'calibrate only current') { @calibration_targets << :current }
        on('-b', '--baud=VALUE', 'baud rate to use to communicate with FC, default is 115200') { |value| @baud = value }
        on('-B', '--battery=BAT', 'battery slot to use on PX4 MAVLink FCs, for example BAT1 or BAT2') { |value| @battery = value }
        on('--csv=FILE', 'append calibration measurements and results to FILE in CSV format') { |value| @csv_path = value }
        on('--quality-thresholds=EXCELLENT,GOOD,FAIR', 'set quality score thresholds, default is 90,75,50') { |value| @quality_thresholds = value }
        on('-d', '--debug') { @debug = true }
        on('-i', '--inav', 'Do not use autodetection, force INAV FC interface') { @fc_software = :inav }
        on('-a', '--ardupilot', 'Do not use autodetection, force Ardupilot FC interface') { @fc_software = :ardupilot }
        on('-d', '--display', 'Display currently measured voltage and current') { @display = true }
        on('--display-all-batteries', 'Display all observed battery voltage/current values') { @display = @display_all_batteries = true }
    end

    def print_usage
        STDERR.puts self
        exit 1
    end

    def set_defaults
        @degug = false
        @display = false
        @display_all_batteries = false
        @baud = 115200
        @csv_path = nil
        @quality_thresholds = CalibrationSampleStats::DEFAULT_QUALITY_THRESHOLDS
        @acquisition_time = 5 # seconds
        @calibration_targets = Array.new
        @calibration_default_targets = %i{ voltage current }
    end

    def validate!
        raise ArgumentError, 'too few arguments' if ARGV.count < 1
        raise ArgumentError, 'too many arguments' if ARGV.count > 1
        @acquisition_time = Integer @acquisition_time rescue raise ArgumentError, "invalid acquisition time, expected integer: #{acquisition_time}" if acquisition_time
        @baud = Integer @baud rescue raise ArgumentError, "invalid baud rate, expected integer: #{baud}" unless baud.is_a? Integer
        @battery = parse_battery @battery if @battery
        @quality_thresholds = parse_quality_thresholds @quality_thresholds if @quality_thresholds.is_a? String
        @calibration_targets = @calibration_default_targets if @calibration_targets.empty?
    end

    def calibrate_current?
        @calibration_targets.include? :current
    end

    def calibrate_voltage?
        @calibration_targets.include? :voltage
    end

    def parse!
        set_defaults
        super
        validate!
        @serial_device = ARGV[0]
        self
    rescue ArgumentError => error
        STDERR.puts "Error: #{error}\n\n"
        print_usage
    end

    %i[ debug display display_all_batteries ].each do |name|
        define_method "#{name}?" do
            instance_variable_get "@#{name}"
        end
    end

    attr_reader :serial_device, :acquisition_time, :baud, :battery, :fc_software, :csv_path, :quality_thresholds

    private

    def parse_battery value
        normalized = value.to_s.strip.upcase
        return normalized if normalized.match?(/\ABAT[1-9]\d*\z/)

        raise ArgumentError, "invalid battery selector, expected BAT1, BAT2, ...: #{value}"
    end

    def parse_quality_thresholds value
        parts = value.to_s.split(',').map(&:strip)
        raise ArgumentError, "invalid quality thresholds, expected EXCELLENT,GOOD,FAIR: #{value}" unless parts.count == 3

        excellent, good, fair = parts.map { |part| Float(part) rescue nil }
        raise ArgumentError, "invalid quality thresholds, expected numeric values: #{value}" if [excellent, good, fair].any?(&:nil?)
        raise ArgumentError, "invalid quality thresholds, expected 100 >= excellent > good > fair >= 0: #{value}" unless excellent <= 100 && excellent > good && good > fair && fair >= 0

        {
            excellent: excellent,
            good: good,
            fair: fair
        }
    end

end

class CalibrationCsvWriter

    HEADERS = %w[
        timestamp
        serial_device
        target_software
        battery
        calibration_type
        measurement_index
        fc_measurement
        true_measurement
        previous_offset
        previous_scale
        offset
        scale
        voltage_offset
        native_voltage_offset
        native_scale
        voltage_scale
        sample_count
        sample_mean
        sample_standard_deviation
        sample_minimum
        sample_maximum
        sample_span
        sample_quality_score
        sample_quality_label
    ].freeze

    def self.append path, calibrator, options
        data = calibrator.calibration_data
        new(path, calibrator, options, data).append
    rescue RuntimeError => error
        raise unless error.message == 'no data available'
    end

    def initialize path, calibrator, options, data
        @path = path
        @calibrator = calibrator
        @options = options
        @data = data
    end

    def append
        write_headers = !File.exist?(path) || File.zero?(path)

        CSV.open(path, 'ab', write_headers: write_headers, headers: HEADERS) do |csv|
            rows.each { |row| csv << HEADERS.map { |header| row[header] } }
        end
    end

    private

    attr_reader :path, :calibrator, :options, :data

    def base_row
        {
            'timestamp' => Time.now.iso8601,
            'serial_device' => options.serial_device,
            'target_software' => calibrator.target_software,
            'battery' => options.battery,
            'previous_offset' => calibrator.respond_to?(:previous_offset) ? calibrator.previous_offset : nil,
            'previous_scale' => calibrator.respond_to?(:previous_scale) ? calibrator.previous_scale : nil,
            'offset' => data[:offset],
            'scale' => data[:scale],
            'voltage_offset' => data[:voltage_offset],
            'native_voltage_offset' => data[:native_voltage_offset],
            'native_scale' => data[:native_scale],
            'voltage_scale' => data[:voltage_scale]
        }
    end

    def measurement_stats_for index
        stats = data[:measurement_stats]
        return nil if stats.nil?
        return stats[index] if stats.is_a? Array

        stats
    end

    def row_with_stats row, stats
        row.merge(
            'sample_count' => stats && stats[:count],
            'sample_mean' => stats && stats[:mean],
            'sample_standard_deviation' => stats && stats[:standard_deviation],
            'sample_minimum' => stats && stats[:minimum],
            'sample_maximum' => stats && stats[:maximum],
            'sample_span' => stats && stats[:span],
            'sample_quality_score' => stats && stats[:quality_score],
            'sample_quality_label' => stats && stats[:quality_label]
        )
    end

    def rows
        if calibrator.is_a?(CurrentCalibrator)
            calibrator.fc_measurements.each_with_index.map do |fc_measurement, index|
                row_with_stats(base_row.merge(
                    'calibration_type' => 'current',
                    'measurement_index' => index,
                    'fc_measurement' => fc_measurement,
                    'true_measurement' => calibrator.true_measurements[index]
                ), measurement_stats_for(index))
            end
        else
            [
                row_with_stats(base_row.merge(
                    'calibration_type' => 'voltage',
                    'measurement_index' => 0,
                    'fc_measurement' => calibrator.fc_measure,
                    'true_measurement' => calibrator.true_value
                ), measurement_stats_for(0))
            ]
        end
    end

end

class RunningSampleStats

    def initialize
        reset!
    end

    def add value
        return if not value.finite?

        @count += 1
        delta = value - @mean
        @mean += delta / @count.to_f
        @sum_square_delta += delta * (value - @mean)
        @minimum = @minimum.nil? ? value : [@minimum, value].min
        @maximum = @maximum.nil? ? value : [@maximum, value].max
        nil
    end

    def reset!
        @count = 0
        @mean = 0.0
        @sum_square_delta = 0.0
        @minimum = nil
        @maximum = nil
        nil
    end

    def to_stats
        return nil if @count.zero?

        variance = @sum_square_delta / @count.to_f
        CalibrationSampleStats.new @count, @mean, Math.sqrt(variance), @minimum, @maximum
    end

end

class DisplayMeasurementStats

    def initialize quality_thresholds
        @quality_thresholds = quality_thresholds
        reset!
    end

    def add sample
        voltage_stats.add sample.voltage
        current_stats.add sample.current
        nil
    end

    def reset!
        @voltage_stats = RunningSampleStats.new
        @current_stats = RunningSampleStats.new
        nil
    end

    def format sample, label
        "#{label} #{format_channel('V', sample.voltage, voltage_stats.to_stats)} #{format_channel('A', sample.current, current_stats.to_stats)}"
    end

    private

    attr_reader :quality_thresholds, :voltage_stats, :current_stats

    def format_channel channel, current_value, stats
        if stats.nil?
            "#{channel}=#{format_value(current_value)} avg=n/a min=n/a max=n/a span=n/a sd=n/a q=n/a"
        else
            "#{channel}=#{format_value(current_value)} avg=#{format_value(stats.mean)} min=#{format_value(stats.minimum)} max=#{format_value(stats.maximum)} span=#{format_value(stats.span)} sd=#{format_value(stats.standard_deviation)} q=#{stats.quality_score.round}/100/#{stats.quality_label(quality_thresholds)} n=#{stats.count}"
        end
    end

    def format_value value
        value.finite? ? format('%.4f', value) : 'nan'
    end

end

class DisplayStatsController

    def initialize quality_thresholds
        @quality_thresholds = quality_thresholds
        @stats_by_id = Hash.new { |hash, key| hash[key] = DisplayMeasurementStats.new quality_thresholds }
    end

    def add sample
        stats_by_id[sample.id].add sample
    end

    def reset!
        stats_by_id.each_value(&:reset!)
        nil
    end

    def format sample
        label = sample.id.nil? ? 'selected' : "id=#{sample.id}"
        stats_by_id[sample.id].format sample, label
    end

    private

    attr_reader :stats_by_id, :quality_thresholds

end

begin

    options = XOptionParser.new.parse!

    fc_software_interface =
        case options.fc_software
        when :inav, :ardupilot
          (options.fc_software == :inav ? INavInterface : ArdupilotInterface).method :new
        else
            FCSoftwareInterface.method :autodetect
                end.call options.serial_device, options.baud, battery: options.battery

    if options.display?
        display_stats = DisplayStatsController.new options.quality_thresholds
        display_loop = proc do
            begin
                sample_chars = [ ?-, ?\\, ?|, ?/ ]
                sample_char_index = 0
                loop do
                    display_stats.reset! if STDIN.tty? && display_reset_requested?
                    line =
                        if options.display_all_batteries?
                            samples = fc_software_interface.sample_voltage_and_currents
                            sample_strings = samples.sort_by { |sample| sample.id || -1 }.map do |sample|
                                display_stats.add sample
                                display_stats.format sample
                            end
                            "%s %s\r" % [ sample_chars[sample_char_index], sample_strings.join(' | ') ]
                        else
                            sample = fc_software_interface.sample_voltage_and_current
                            battery_sample = FCSoftwareInterface::BatterySample.new nil, sample.voltage, sample.current
                            display_stats.add battery_sample
                            "%s %s\r" % [ sample_chars[sample_char_index], display_stats.format(battery_sample) ]
                        end
                    STDOUT.update_line line
                    sample_char_index = (sample_char_index < sample_chars.count - 1) ? sample_char_index + 1 : 0
                    sleep 0.2
                end
            rescue Interrupt
                print "\r"
                STDOUT.clear_line
                exit 0
            end
        end

        STDOUT.one_line_progress title: 'Display mode: press space or enter to reset stats, ctrl-c to exit', keep_line: false do
            if STDIN.tty?
                STDIN.raw { display_loop.call }
            else
                display_loop.call
            end
        end
    end

    if options.calibrate_current?
        raise "No current sensor present on the board" unless fc_software_interface.current_sensor_present?
        unless fc_software_interface.current_sensor_enabled?
            if Term.ask_yes_no "The current sensor is not enabled. Enable ? [y] ", true
                STDERR.puts "Enabling current sensor"
                fc_software_interface.enable_current_sensor
            else
                STDERR.puts "Current calibration skipped"
            end
            STDERR.puts
        end
    end

    if options.calibrate_voltage?
        raise "No voltage sensor present on the board" unless fc_software_interface.voltage_sensor_present?
        unless fc_software_interface.voltage_sensor_enabled?
            if Term.ask_yes_no "The voltage sensor is not enabled. Enable ? [y] ", true
                STDERR.puts "Enabling voltage sensor"
                fc_software_interface.enable_voltage_sensor
            else
                STDERR.puts "Voltage calibration skipped"
            end
            STDERR.puts
        end
    end

    if fc_software_interface.needs_reboot?
        if Term.ask_yes_no "FC configuration modified. Save & reboot ? [y] ", true
            fc_software_interface.save_settings
            STDERR.write 'Rebooting FC...'
            fc_software_interface.reboot_fc
            STDERR.puts
        end
        STDERR.puts
    end

    if options.calibrate_voltage? and fc_software_interface.voltage_sensor_enabled?
        voltage_calibrator = VoltageCalibrator.new(fc_software_interface, acquisition_time: options.acquisition_time, quality_thresholds: options.quality_thresholds)
        voltage_calibrator.run
        CalibrationCsvWriter.append options.csv_path, voltage_calibrator, options if options.csv_path
    end

    if options.calibrate_current? and fc_software_interface.current_sensor_enabled?
        puts if options.calibrate_voltage? and fc_software_interface.voltage_sensor_enabled?
        current_calibrator = CurrentCalibrator.new(fc_software_interface, acquisition_time: options.acquisition_time, quality_thresholds: options.quality_thresholds)
        current_calibrator.run
        CalibrationCsvWriter.append options.csv_path, current_calibrator, options if options.csv_path
    end

rescue Interrupt
    STDERR.puts "User interrupt"
    exit 1
rescue FCSoftwareInterface::Error::FirmwareAutodetectionFailed,
       FCSoftwareInterface::Error::BatterySensorNotSupported,
       CurrentCalibrator::InvalidResults,
       Errno::EIO,
       OptionParser::MissingArgument,
       OptionParser::InvalidOption,
       Errno::EBUSY => error
    if options.debug?
        raise
    else
        STDERR.puts "Error: #{error}"
        exit 2
    end
end

def display_reset_requested?
    reset_requested = false

    while IO.select([STDIN], nil, nil, 0)
        key = STDIN.read_nonblock(1, exception: false)
        break if key == :wait_readable || key.nil?

        reset_requested ||= [" ", "\r", "\n"].include? key
    end

    reset_requested
end
